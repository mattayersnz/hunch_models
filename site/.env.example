# From `supabase status` locally, or the hosted project's API settings.
# Hosted: https://<your-project-ref>.supabase.co
SUPABASE_URL=http://127.0.0.1:55321
SUPABASE_ANON_KEY=
# Server only. Never expose it to a page.
SUPABASE_SERVICE_ROLE_KEY=
# Salts the hash kept for each responder's IP address. Any long random string.
IP_SALT=
# The public origin links are written with, e.g. https://models.hunch.tech
SITE_URL=http://127.0.0.1:4620
